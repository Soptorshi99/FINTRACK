MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=finance_platform

# JWT — generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real SECRET_KEY to source control
SECRET_KEY=your-strong-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI (Ollama Cloud)
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_API_URL=https://ollama.com/api
OLLAMA_MODEL=gpt-oss:20b

# Email SMTP — required for real email delivery (verification, password reset)
# Leave blank to fall back to mock logging (dev mode)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# Frontend URL used in verification/reset email links
APP_URL=http://localhost:5173

# Set to true to require users to verify email before logging in
EMAIL_VERIFICATION_REQUIRED=False
